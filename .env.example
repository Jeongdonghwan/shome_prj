# 복사해서 .env 로 저장 후 값 채우기
# SECRET_KEY는 반드시 고정값이어야 한다. 비워두면 gunicorn 워커마다
# 키가 달라져서 어드민 로그인이 계속 튕긴다.
SECRET_KEY=change-me-random-hex
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sedamhome
DB_USER=sedamhome
DB_PASSWORD=
ADMIN_ID=
ADMIN_PW=
# 배포 도메인 (sitemap/robots). 예: https://sedamhome.com
SITE_URL=https://sedamhome.com
# 카카오톡 채널 URL
KAKAO_CHANNEL_URL=https://pf.kakao.com/_qUgkn
